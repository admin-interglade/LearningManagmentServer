NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/interglade_exam
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Seeded admin (used by npm run db:seed)
ADMIN_EMAIL=admin@interglade.com
ADMIN_PASSWORD=Admin@12345

# Optional SMTP for password reset emails (logged to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Interglade Talent <no-reply@interglade.com>"
