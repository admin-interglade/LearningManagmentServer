# ---- App ----
NODE_ENV=development
PORT=5050
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Either a full connection string (used when set)...
DATABASE_URL=
# ...or individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=online_examination
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false
# Keep false; schema changes go through migrations
DB_SYNCHRONIZE=false

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=1d
JWT_RESET_SECRET=change-me-too
JWT_RESET_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# true = create orders locally without calling Razorpay (development only)
RAZORPAY_MOCK=false
DEFAULT_CURRENCY=INR

# ---- Notifications ----
# console = log messages instead of sending (development)
NOTIFICATION_DRIVER=console
NOTIFICATION_MAX_RETRIES=3
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=no-reply@example.com
# India DLT gateway (to be finalized)
DLT_API_URL=
DLT_API_KEY=
DLT_SENDER_ID=

# ---- Seed (first admin) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
